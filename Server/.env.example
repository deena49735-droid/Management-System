# Server Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kadambas?retryWrites=true&w=majority

# JWT Authentication
# JWT_EXPIRES_IN default: 12h (standard session lifetime and all admin accounts)
# JWT_REMEMBER_EXPIRES_IN default: 30d (extended lifetime for non-admin when remember is true)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# Client Application URL (CORS origin)
CLIENT_URL=http://localhost:5173

# Admin Seed Account Details
ADMIN_NAME=Super Admin
ADMIN_USERNAME=admin
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=AdminPassword123!

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret





